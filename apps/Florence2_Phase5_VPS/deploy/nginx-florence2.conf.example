# Optional: place inside an existing HTTPS server block after configuring TLS.
# Keep the upstream private. Basic auth is an additional boundary; /analyze also requires its bearer key.
location /florence/ {
    auth_basic "Florence-2";
    auth_basic_user_file /etc/nginx/lnfs-florence2.htpasswd;
    client_max_body_size 10m;
    proxy_read_timeout 300s;
    proxy_pass http://127.0.0.1:8000/;
}
