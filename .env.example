# App
NODE_ENV=development
API_PORT=3001
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=apps/api-node/uploads

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lnfs_auth
DB_USER=root
DB_PASSWORD=change_me
DB_SSL=false
# Aiven: download the CA certificate and set a repo-local path, for example:
# DB_SSL_CA_PATH=certs/aiven-ca.pem

# Generate distinct, long random values. Never commit real values.
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# Gmail SMTP: create an App Password with 2-Step Verification enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
SMTP_FROM="FPTU Lost & Found <your-gmail-address@gmail.com>"

# Optional: Gemini image understanding for post draft suggestions.
# Keep the real key server-side. Never expose it through VITE_* variables.
GEMINI_API_KEY=replace_with_a_server_side_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=30000

# Optional: Cloudinary authenticated avatar storage.
# Never commit real credentials.
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

# Auth controls
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
BCRYPT_SALT_ROUNDS=12
COOKIE_SECURE=false

# Local-only moderation seed safety gate. Do not set these for Aiven/production.
# ALLOW_DESTRUCTIVE_SEED=false
# SEED_DATABASE_NAME=lnfs_test
