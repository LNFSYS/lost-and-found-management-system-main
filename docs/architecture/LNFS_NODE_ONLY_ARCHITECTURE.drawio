  <diagram id="lnfs-be-packages" name="BE Package Diagram">
    <mxGraphModel fold="1" pageWidth="1800" dx="1800" tooltips="1" guides="1" connect="1" grid="1" shadow="0" math="0" pageHeight="1250" dy="1250" gridSize="10" pageScale="1" page="1" arrows="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell vertex="1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#17324D;fontSize=30;fontStyle=1;" id="be-title" value="LNFS Backend Package Diagram">
          <mxGeometry y="30" width="1620" as="geometry" height="50" x="60" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#17324D;fontSize=16;" id="be-subtitle" value="Clean Architecture modular monolith | apps/api-node/src | No Java backend | No business or API changes">
          <mxGeometry y="85" width="1620" as="geometry" height="30" x="60" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontSize=15;fontColor=#17324D;strokeWidth=2;strokeColor=#ED773B;fillColor=#FFF3EC;" id="be-main" value="&lt;b&gt;main/ - Composition root&lt;/b&gt;&lt;br&gt;&lt;br&gt;server / app / http: lifecycle, Express and route assembly &amp;nbsp;&amp;nbsp; | &amp;nbsp;&amp;nbsp; database / persistence: one pool and repository factories&lt;br&gt;services / runtime: inject repository, transaction, media, email, AI, security and logger adapters into use cases">
          <mxGeometry y="140" width="1620" as="geometry" height="125" x="60" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontSize=15;fontColor=#17324D;strokeWidth=2;strokeColor=#7C99B4;fillColor=#F5F8FB;" id="be-modules" value="&lt;b&gt;modules/&lt;/b&gt;&lt;br&gt;&lt;br&gt;auth&lt;br&gt;posts&lt;br&gt;matching&lt;br&gt;claims&lt;br&gt;notifications&lt;br&gt;warehouse&lt;br&gt;returns&lt;br&gt;admin&lt;br&gt;system-config&lt;br&gt;&lt;br&gt;&lt;b&gt;Public cross-module contracts&lt;/b&gt;&lt;br&gt;application/index.ts&lt;br&gt;&lt;br&gt;Only the contracts needed by other modules are exported.&lt;br&gt;&lt;br&gt;No deep import into another module's implementation.">
          <mxGeometry y="305" width="275" as="geometry" height="790" x="60" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="swimlane;html=1;startSize=35;fontSize=15;fontStyle=1;strokeColor=#B8C8D8;fillColor=#FFFFFF;rounded=0;" id="be-feature" value="PER FEATURE MODULE - dependency direction points inward">
          <mxGeometry y="305" width="1310" as="geometry" height="395" x="370" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontSize=15;fontColor=#17324D;strokeWidth=2;strokeColor=#2E79BD;fillColor=#EAF4FF;" id="be-interfaces" value="&lt;b&gt;interfaces/http/&lt;/b&gt;&lt;br&gt;&lt;br&gt;Express router factories&lt;br&gt;Controllers&lt;br&gt;Zod request validation&lt;br&gt;Upload/rate limits&lt;br&gt;&lt;br&gt;Parse, call, map response">
          <mxGeometry y="390" width="270" as="geometry" height="235" x="395" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontSize=15;fontColor=#17324D;strokeWidth=2;strokeColor=#55A944;fillColor=#EEF8EF;" id="be-application" value="&lt;b&gt;application/&lt;/b&gt;&lt;br&gt;&lt;br&gt;create*UseCases(dependencies)&lt;br&gt;Plain TypeScript input/output DTOs&lt;br&gt;Repository and provider ports&lt;br&gt;&lt;br&gt;Authorization and workflow orchestration&lt;br&gt;TransactionRunner + opaque context&lt;br&gt;Public application/index.ts contracts">
          <mxGeometry y="365" width="420" as="geometry" height="290" x="770" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontSize=15;fontColor=#17324D;strokeWidth=2;strokeColor=#BA922A;fillColor=#FFF9E8;" id="be-domain" value="&lt;b&gt;domain/&lt;/b&gt;&lt;br&gt;&lt;br&gt;Matching score and explanations&lt;br&gt;Post state/access rules&lt;br&gt;Claim room consent&lt;br&gt;Warehouse retention/transitions&lt;br&gt;Auth session and media rules">
          <mxGeometry y="390" width="345" as="geometry" height="235" x="1310" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontSize=15;fontColor=#17324D;strokeWidth=2;strokeColor=#7C99B4;fillColor=#F0F4F8;" id="be-infrastructure" value="&lt;b&gt;infrastructure/&lt;/b&gt;&lt;br&gt;&lt;br&gt;MySQL repository implementations&lt;br&gt;SMTP, Gemini, Cloudinary adapters&lt;br&gt;Filesystem + SQL transaction adapter&lt;br&gt;&lt;br&gt;Implements application-owned ports">
          <mxGeometry y="790" width="420" as="geometry" height="175" x="770" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontSize=15;fontColor=#17324D;strokeWidth=2;strokeColor=#7C99B4;fillColor=#F5F8FB;" id="be-shared" value="&lt;b&gt;shared/&lt;/b&gt;&lt;br&gt;&lt;br&gt;domain: auth vocabulary, errors, media/text&lt;br&gt;application: transaction, media, logger ports&lt;br&gt;infrastructure: config, SQL, files, security&lt;br&gt;interfaces/http: auth, cookies, error mapping&lt;br&gt;&lt;br&gt;No shared -&gt; business module dependency">
          <mxGeometry y="765" width="370" as="geometry" height="240" x="1310" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontSize=15;fontColor=#17324D;strokeWidth=2;strokeColor=#BA922A;fillColor=#FFF9E8;" id="be-migrations" value="&lt;b&gt;migrations/&lt;/b&gt;&lt;br&gt;&lt;br&gt;Existing numbered SQL&lt;br&gt;Checksum ledger + attempt log&lt;br&gt;Named migration lock&lt;br&gt;&lt;br&gt;Node-only schema owner&lt;br&gt;SQL files unchanged">
          <mxGeometry y="790" width="270" as="geometry" height="205" x="395" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontSize=15;fontColor=#17324D;strokeWidth=2;spacing=12;strokeColor=#ED773B;fillColor=#FFF3EC;" id="be-resources" value="&lt;b&gt;Runtime resources&lt;/b&gt;&lt;br&gt;MySQL / SMTP / Gemini / Cloudinary&lt;br&gt;Protected local media files">
          <mxGeometry y="1035" width="420" as="geometry" height="75" x="770" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontSize=15;fontColor=#17324D;strokeWidth=2;spacing=14;fontSize=14;strokeColor=#55A944;fillColor=#EEF8EF;" id="be-rules" value="&lt;b&gt;Enforced rules:&lt;/b&gt; core has no Express, mysql2, SDK, environment or direct console dependency. No circular dependencies, including types.&lt;br&gt;&lt;b&gt;Verification:&lt;/b&gt; npm run check:architecture; fake-port unit tests; isolated MySQL/HTTP regression; unchanged frontend browser tests.&lt;br&gt;Solid arrows: source dependency. Dashed arrows: composition or runtime I/O. No new product features are implemented by this refactor.">
          <mxGeometry y="1140" width="1620" as="geometry" height="80" x="60" />
        </mxCell>
        <mxCell id="be-http-app" source="be-interfaces" value="invokes" edge="1" parent="1" target="be-application" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;fontColor=#334155;labelBackgroundColor=#FFFFFF;strokeColor=#2E79BD;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
