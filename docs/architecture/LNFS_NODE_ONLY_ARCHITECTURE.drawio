        <mxCell id="sa-domain-d" value="&lt;b&gt;AI Decision Support&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657A&quot;&gt;Gemini-assisted editable draft&lt;br&gt;Explainable rule-v2 matching&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#C39A2E;fillColor=#FFF9E8;fontColor=#0B2545;" vertex="1" parent="sa-api">
