        <mxCell id="sa-domain-c" value="&lt;b&gt;Operations&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657A&quot;&gt;Warehouse · admin users/config&lt;br&gt;moderation/reporting · return feedback&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#8AA9C8;fillColor=#FFFFFF;fontColor=#0B2545;" vertex="1" parent="sa-api">
