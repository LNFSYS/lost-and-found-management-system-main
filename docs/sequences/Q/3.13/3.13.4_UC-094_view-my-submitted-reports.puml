' Source: apps/api-node/src/modules/reports/application/report.use-cases.ts
' Main entity migration: apps/api-node/src/migrations/002_lost_found_schema.sql
' One-table abstraction: related repository reads/writes stay inside the service.
actor "Authenticated User" as Actor
participant "My Reports Page" as Page
participant "Report API" as API
participant "Report Service" as Service
participant "reports" as Table <<entity>>

Actor -> Page: 1: View my submitted reports
activate Page
Page -> Page: 2: Read status and pagination filters
Page -> API: 3: GET /api/reports/mine
activate API
API -> API: 4: Authenticate active session
alt Session and required permission are valid
    API -> API: 5: Validate report status and page size (1..50)
    alt Request input is valid
        API -> Service: 6: View my submitted reports for the current actor
        activate Service
        Service -> Table: 7: Count and read reports WHERE reporter_id = current user
        activate Table
        Table --> Service: 8: Own report rows and total, or error
        deactivate Table
        alt Operation succeeds
            Service --> API: 9: Own paginated reports
            API --> Page: 10: HTTP 200: Own paginated reports
            Page --> Actor: 11: Display processing states; show empty state if needed
        else Query or response mapping failure
            Service -> Service: 9.1: Do not fabricate data; propagate the query or mapping failure
            Service --> API: 9.2: Propagate read failure
            API --> Page: 9.3: HTTP 503 or 500
            Page --> Actor: 9.4: Display error; do not report success
        end
        deactivate Service
    else Invalid request input
        API --> Page: 6.1: HTTP 422: input validation errors
        Page --> Actor: 6.2: Display validation errors; do not execute the operation
    end
else Missing/invalid session or required permission
    API --> Page: 5.1: HTTP 401 or 403
    Page --> Actor: 5.2: Show session or access error; no protected result
end
deactivate API
deactivate Page

@enduml
