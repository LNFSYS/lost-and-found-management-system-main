' Source: apps/api-node/src/modules/reports/application/report.use-cases.ts
' Main entity migration: apps/api-node/src/migrations/002_lost_found_schema.sql
' One-table abstraction: related repository reads/writes stay inside the service.
actor "Authenticated User" as Actor
participant "My Report Detail Page" as Page
participant "Report API" as API
participant "Report Service" as Service
participant "reports" as Table <<entity>>

Actor -> Page: 1: Withdraw a pending report
activate Page
Page -> Page: 2: Confirm withdrawal of own report
Page -> API: 3: POST /api/reports/mine/:id/withdraw
activate API
API -> API: 4: Authenticate active session
alt Session and required permission are valid
    API -> API: 5: Validate report UUID
    alt Request input is valid
        API -> Service: 6: Withdraw a pending report for the current actor
        activate Service
        Service -> Service: 7: Begin transaction
        Service -> Table: 8: Lock report FOR UPDATE
        activate Table
        Table --> Service: 9: Reporter, status and reviewed_at
        deactivate Table
        alt Own PENDING report has not been reviewed
            Service -> Table: 10: Conditionally set WITHDRAWN and withdrawn_at
            activate Table
            Table --> Service: 11: Affected row count
            deactivate Table
            alt One pending report was updated
                Service -> Service: 12: Record WITHDRAWN audit; read own detail and commit
                alt Operation succeeds
                    Service --> API: 13: Withdrawn report
                    API --> Page: 14: HTTP 200: Withdrawn report
                    Page --> Actor: 15: Display withdrawn state
                else Query, write or commit failure
                    Service -> Service: 13.1: Propagate failure; rollback only when transaction failure is\nconfirmed
                    Service --> API: 13.2: Propagate storage or transaction failure
                    API --> Page: 13.3: HTTP 503 or 500
                    Page --> Actor: 13.4: Display error; do not report success
                end
            else Review won the concurrent update
                Service --> API: 12.1: Report is no longer pending
                API --> Page: 12.2: HTTP 409
                Page --> Actor: 12.3: Display error; do not report success
            end
        else Own report already WITHDRAWN
            Service -> Service: 10.1: Read existing withdrawn report; finish transaction
            Service --> API: 10.2: Existing withdrawn report
            API --> Page: 10.3: HTTP 200: Existing withdrawn report
            Page --> Actor: 10.4: Keep withdrawn state without duplicate audit
        else Report belongs to another user or does not exist
            Service --> API: 10.5: Own report not found
            API --> Page: 10.6: HTTP 404
            Page --> Actor: 10.7: Display error; do not report success
        else Report has already been reviewed
            Service --> API: 10.8: Reviewed report cannot be withdrawn
            API --> Page: 10.9: HTTP 409
            Page --> Actor: 10.10: Display error; do not report success
        end
        deactivate Service
    else Invalid request input
        API --> Page: 6.1: HTTP 422: input validation errors
        Page --> Actor: 6.2: Display validation errors; do not execute the operation
    end
else Missing/invalid session or required permission
    API --> Page: 5.1: HTTP 401 or 403
    Page --> Actor: 5.2: Show session or access error; no protected result
end
deactivate API
deactivate Page

@enduml
