' Source: apps/api-node/src/modules/warehouse/application/warehouse.use-cases.ts
' Main entity migration: apps/api-node/src/migrations/054_custody_safety_contract.sql
' One-table abstraction: related repository reads/writes stay inside the service.
actor "Admin" as Actor
participant "Disposition Detail (proposed)" as Page
participant "Staff API" as API
participant "Warehouse Service" as Service
participant "warehouse_action_approvals" as Table <<entity>>

Actor -> Page: 1: Cancel a disposition order
activate Page
Page -> Page: 2: Choose cancellation and enter reason
Page -> API: 3: Cancel disposition request (proposed interface)
activate API
API -> API: 4: Authenticate active session and require STAFF or ADMIN
alt Session and required permission are valid
    API -> API: 5: Proposed: validate id, reason and ADMIN permission
    alt Request input is valid
        API -> Service: 6: Cancel a disposition order for the current actor
        activate Service
        Service -> Service: 7: Begin proposed transaction
        Service -> Table: 8: Lock disposition and check execution state (proposed)
        activate Table
        Table --> Service: 9: Approval and execution state
        deactivate Table
        alt Approved request has not been executed
            Service -> Table: 10: Store proposed CANCELLED state, actor, reason and time
            activate Table
            Table --> Service: 11: Proposed cancellation result
            deactivate Table
            Service -> Service: 12: Record cancellation audit; commit; retain item custody/history
            Service --> API: 13: Cancelled disposition (proposed)
            API --> Page: 14: HTTP 200 (proposed): Cancelled disposition (proposed)
            Page --> Actor: 15: Display cancellation without returning or disposing item
        else Request missing, already executed or invalid state
            Service --> API: 10.1: Cancellation is not allowed
            API --> Page: 10.2: HTTP 404 or 409 (proposed)
            Page --> Actor: 10.3: Display error; do not report success
        end
        deactivate Service
    else Invalid request input
        API --> Page: 6.1: Proposed validation error response
        Page --> Actor: 6.2: Display validation errors; do not execute the operation
    end
else Missing/invalid session or required permission
    API --> Page: 5.1: Proposed authentication/access error response
    Page --> Actor: 5.2: Show session or access error; no protected result
end
deactivate API
deactivate Page

legend bottom left
PLANNED: cancellation API/UI is absent; warehouse_action_approvals does not yet support a CANCELLED
state. Schema extension is proposed only.
endlegend

@enduml
