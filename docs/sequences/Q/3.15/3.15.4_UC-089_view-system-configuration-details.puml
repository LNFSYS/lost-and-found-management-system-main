actor "Admin" as Actor
participant "Configuration Detail" as Page
participant "Admin Config API" as API
participant "Config Service" as Service
participant "config_entries" as Table <<entity>>

Actor -> Page: 1: View system configuration details
activate Page
Page -> Page: 2: Select configuration entry
Page -> API: 3: GET /api/admin/configs/:id
activate API
API -> API: 4: Authenticate active session and require ADMIN role
alt Session and required permission are valid
    API -> API: 5: Validate configuration UUID
    alt Request input is valid
        API -> Service: 6: View system configuration details for the current actor
        activate Service
        Service -> Table: 7: Find configuration by id
        activate Table
        Table --> Service: 8: Configuration or no record
        deactivate Table
        alt Configuration exists
            Service -> Service: 9: Redact sensitive value when required
            Service --> API: 10: Safe configuration detail
            API --> Page: 11: HTTP 200: Safe configuration detail
            Page --> Actor: 12: Display typed value, visibility and metadata
        else Configuration missing
            Service --> API: 9.1: Configuration not found
            API --> Page: 9.2: HTTP 404
            Page --> Actor: 9.3: Display error; do not report success
        end
        deactivate Service
    else Invalid request input
        API --> Page: 6.1: HTTP 422: input validation errors
        Page --> Actor: 6.2: Display validation errors; do not execute the operation
    end
else Missing/invalid session or required permission
    API --> Page: 5.1: HTTP 401 or 403
    Page --> Actor: 5.2: Show session or access error; no protected result
end
deactivate API
deactivate Page

