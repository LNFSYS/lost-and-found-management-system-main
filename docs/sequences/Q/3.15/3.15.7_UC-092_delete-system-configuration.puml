' Source: apps/api-node/src/modules/system-config/application/system-config.use-cases.ts
' Main entity migration: apps/api-node/src/migrations/002_lost_found_schema.sql
' One-table abstraction: related repository reads/writes stay inside the service.
actor "Admin" as Actor
participant "Configuration Page" as Page
participant "Admin Config API" as API
participant "Config Service" as Service
participant "config_entries" as Table <<entity>>

Actor -> Page: 1: Delete system configuration
activate Page
Page -> Page: 2: Confirm deletion and optional reason
Page -> API: 3: DELETE /api/admin/configs/:id
activate API
API -> API: 4: Authenticate active session and require ADMIN role
alt Session and required permission are valid
    API -> API: 5: Validate configuration UUID
    alt Request input is valid
        API -> Service: 6: Delete system configuration for the current actor
        activate Service
        Service -> Service: 7: Begin transaction
        Service -> Table: 8: Lock configuration FOR UPDATE
        activate Table
        Table --> Service: 9: Configuration or no record
        deactivate Table
        alt Configuration exists
            Service -> Table: 10: Delete configuration by id
            activate Table
            Table --> Service: 11: Deletion result
            deactivate Table
            Service -> Service: 12: Record DELETE history and administrative audit; commit transaction
            alt Operation succeeds
                Service --> API: 13: Deletion completed
                API --> Page: 14: HTTP 204: Deletion completed
                Page --> Actor: 15: Remove entry from list
            else Query, write or commit failure
                Service -> Service: 13.1: Propagate failure; rollback only when transaction failure is\nconfirmed
                Service --> API: 13.2: Propagate storage or transaction failure
                API --> Page: 13.3: HTTP 503 or 500
                Page --> Actor: 13.4: Display error; do not report success
            end
        else Configuration missing
            Service --> API: 10.1: Configuration not found
            API --> Page: 10.2: HTTP 404
            Page --> Actor: 10.3: Display error; do not report success
        end
        deactivate Service
    else Invalid request input
        API --> Page: 6.1: HTTP 422: input validation errors
        Page --> Actor: 6.2: Display validation errors; do not execute the operation
    end
else Missing/invalid session or required permission
    API --> Page: 5.1: HTTP 401 or 403
    Page --> Actor: 5.2: Show session or access error; no protected result
end
deactivate API
deactivate Page

@enduml
