' Source: apps/api-node/src/modules/system-config/application/system-config.use-cases.ts
' Main entity migration: apps/api-node/src/migrations/002_lost_found_schema.sql
' One-table abstraction: related repository reads/writes stay inside the service.
actor "Admin" as Actor
participant "Create Configuration Dialog" as Page
participant "Admin Config API" as API
participant "Config Service" as Service
participant "config_entries" as Table <<entity>>

Actor -> Page: 1: Create system configuration
activate Page
Page -> Page: 2: Enter key, typed value, visibility, description and reason
Page -> API: 3: POST /api/admin/configs
activate API
API -> API: 4: Authenticate active session and require ADMIN role
alt Session and required permission are valid
    API -> API: 5: Validate key syntax and supported value type
    alt Request input is valid
        API -> Service: 6: Create system configuration for the current actor
        activate Service
        Service -> Service: 7: Reject sensitive keys; canonicalize typed value; enforce public\nallowlist
        alt Key, value and public exposure are permitted
            Service -> Service: 8: Begin transaction
            Service -> Table: 9: Find existing configuration by key
            activate Table
            Table --> Service: 10: Existing entry or no record
            deactivate Table
            alt Key is unused
                Service -> Table: 11: Insert typed configuration and read created entry
                activate Table
                Table --> Service: 12: Created config or write error
                deactivate Table
                Service -> Service: 13: Record CREATE history and administrative audit; commit transaction
                alt Operation succeeds
                    Service --> API: 14: Created configuration
                    API --> Page: 15: HTTP 201: Created configuration
                    Page --> Actor: 16: Show created entry
                else Query, write or commit failure
                    Service -> Service: 14.1: Propagate failure; rollback only when transaction failure is\nconfirmed
                    Service --> API: 14.2: Propagate storage or transaction failure
                    API --> Page: 14.3: HTTP 503 or 500
                    Page --> Actor: 14.4: Display error; do not report success
                end
            else Duplicate configuration key
                Service --> API: 11.1: Configuration key already exists
                API --> Page: 11.2: HTTP 409
                Page --> Actor: 11.3: Display error; do not report success
            end
        else Sensitive key, invalid typed value or unsafe public exposure
            Service --> API: 8.1: Reject invalid configuration
            API --> Page: 8.2: HTTP 422
            Page --> Actor: 8.3: Display error; do not report success
        end
        deactivate Service
    else Invalid request input
        API --> Page: 6.1: HTTP 422: input validation errors
        Page --> Actor: 6.2: Display validation errors; do not execute the operation
    end
else Missing/invalid session or required permission
    API --> Page: 5.1: HTTP 401 or 403
    Page --> Actor: 5.2: Show session or access error; no protected result
end
deactivate API
deactivate Page

@enduml
